# 复制为 .env 并填入你自己的密钥。没有的可留空/删行，对应上游在 providers.json 里设 enabled=false。

# 阿里云百炼 DashScope API Key (https://bailian.console.aliyun.com -> API-KEY)
BAILIAN_API_KEY=

# 阿里云 AccessKey（可选，用于实时查询百炼免费计划状态；需 AliyunBSSReadOnlyAccess 权限）
ALIYUN_AK_ID=
ALIYUN_AK_SECRET=

# 硅基流动 API Key (https://cloud.siliconflow.cn/account/ak)，有永久免费模型
SILICONFLOW_API_KEY=

# 智谱 BigModel API Key (https://bigmodel.cn/usercenter/proj-mgmt/apikeys)，glm-5.3-flash 免费
ZHIPU_API_KEY=

# DeepSeek API Key（可选）
DEEPSEEK_API_KEY=

# ---- 可选环境变量 ----
# 免费额度抓取用的 chromium 路径（默认自动探测 playwright 安装目录）
# LLMGW_CHROME_PATH=C:\path\to\chrome.exe
# 浏览器登录态目录（默认项目根 .pw-profile）
# LLMGW_PROFILE_DIR=
