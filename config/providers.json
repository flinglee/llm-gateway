{
  "policy": {
    "default_task": "balanced",
    "daily_budget_cny": 5.0,
    "budget_action": "downgrade",
    "prefer_free": true,
    "free_first_then_cheapest": true,
    "free_low_watermark": 2000,
    "cache_enabled": true,
    "cache_ttl_seconds": 172800,
    "cache_max_entries": 20000,
    "cooldown_seconds": 180,
    "max_retries": 2,
    "note": "default_task=cheap|balanced|quality|free；budget_action=downgrade|reject；prefer_free=true 时优先用掉还有免费额度的模型；free_first_then_cheapest=true 时免费用尽后取全局最便宜（quality 档仍保质量下限）；free_low_watermark=免费额度低水位阈值(tokens)，剩余<=该值即视为快耗尽、自动切付费包（39元），默认2000，设0表示用尽最后一token才切"
  },
